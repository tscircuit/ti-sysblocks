{
  "name": "@tscircuit/ti-sysblocks",
  "version": "0.1.0",
  "description": "Reusable React components for interactive TI system block diagrams",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib"
  ],
  "module": "lib/index.ts",
  "types": "lib/index.ts",
  "exports": {
    ".": "./lib/index.ts",
    "./style.css": "./lib/SysBlockDiagram.css"
  },
  "scripts": {
    "generate": "bun scripts/generate-ti-diagrams.ts",
    "audit:ti": "bun run generate && git diff --exit-code -- lib/generated pages",
    "start": "cosmos",
    "build:site": "bun run validate:diagrams && cosmos-export",
    "typecheck": "tsc --noEmit",
    "validate:diagrams": "node scripts/validate-diagrams.mjs",
    "build": "bun run validate:diagrams && bun run typecheck",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.4",
    "react-cosmos": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/ti-sysblocks.git"
  },
  "license": "MIT"
}
