{
  "name": "@tscircuit/ti-sysblocks",
  "version": "0.1.0",
  "description": "Reusable React components for interactive TI system block diagrams",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "src/diagrams/*.svg", "src/diagrams/*.json"],
  "main": "./dist/ti-sysblocks.js",
  "module": "./dist/ti-sysblocks.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ti-sysblocks.js"
    },
    "./style.css": "./dist/ti-sysblocks.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.lib.json",
    "build:lib": "npm run build:types && vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "validate:diagrams": "node scripts/validate-diagrams.mjs",
    "build": "npm run validate:diagrams && npm run typecheck && npm run build:lib && npm run build:demo"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/ti-sysblocks.git"
  },
  "license": "MIT"
}
