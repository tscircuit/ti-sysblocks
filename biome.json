{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "**",
      "!!dist/**",
      "!!lib/generated/**",
      "!!pages/**",
      "!!cosmos-export/**"
    ]
  }
}
